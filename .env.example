# Copy to apps/api/.env and apps/web/.env.local as noted below.

# ---- apps/api/.env -------------------------------------------------------
DATABASE_URL="postgresql://aim:aim@localhost:5432/aim_command_center?schema=public"
API_PORT=4000
# Pepper mixed into session token hashing. Rotate to invalidate every session.
SESSION_SECRET="change-me-to-a-long-random-string"
SESSION_TTL_HOURS=12
# Comma-separated origins allowed to call the API directly (the web app calls
# it server-to-server, so in production this can usually stay empty).
CORS_ORIGINS="http://localhost:3000"
NODE_ENV=development

# ---- apps/web/.env.local -------------------------------------------------
# Server-side only. Never exposed with a NEXT_PUBLIC_ prefix, so the browser
# never learns the API address and never holds a session credential.
API_BASE_URL="http://localhost:4000"
